# name: 'nonissue'
# url: 'https://github.com/nonissue/dotfiles'
#
# Named-ANSI version: every color references one of the 16 ANSI palette slots
# (or `normal` = default fg), so ALL shell/prompt colors resolve through the
# active terminal (Ghostty) theme. Switch Ghostty light/dark or to any other
# theme and this tracks it automatically — no hardcoded hex.
#
# The original hand-tuned hex shades are archived as nonissue-classic.theme.
# NOTE: editing this file does not re-apply it (theme vars are universal and
# persist). After changing it, run:  fish_config theme choose nonissue


# fish_color_cwd_root red
fish_color_autosuggestion brblack
fish_color_cancel red
fish_color_command blue
fish_color_comment brblack
fish_color_custom_one blue
fish_color_custom_two brblue
fish_color_cwd cyan
fish_color_end yellow
fish_color_error brred
fish_color_escape cyan
fish_color_gray brblack
fish_color_gray_bg brblack
fish_color_gray_bg_dark black
fish_color_host normal
fish_color_host_remote yellow
fish_color_keyword cyan
fish_color_match red
fish_color_normal normal
fish_color_operator yellow
fish_color_option green
fish_color_param normal
fish_color_quote green
fish_color_redirection magenta
fish_color_search_match --background=yellow
fish_color_selection --background=yellow
fish_color_status red
fish_color_user cyan
fish_color_valid_path --underline
fish_pager_color_completion blue
fish_pager_color_description yellow
fish_pager_color_prefix green
fish_pager_color_progress brwhite '--background=cyan'
fish_pager_color_selected_background --background=yellow

fish_pager_color_background normal
# fish_pager_color_secondary_background
# fish_pager_color_secondary_completion
# fish_pager_color_secondary_description
# fish_pager_color_secondary_prefix

# fish_pager_color_selected_completion
# fish_pager_color_selected_description
# fish_pager_color_selected_prefix
