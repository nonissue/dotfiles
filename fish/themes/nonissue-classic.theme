# name: 'nonissue-classic'
# url: 'https://github.com/nonissue/dotfiles'
# preferred_background: 181825
#
# Archived hand-tuned hex version of the nonissue theme. These are absolute
# RGB values, so they do NOT track the terminal (Ghostty) theme — tuned for a
# dark background. The active 'nonissue' theme is now a named-ANSI version that
# follows whatever Ghostty theme is selected. Re-select this with:
#   fish_config theme choose nonissue-classic


# fish_color_cwd_root red
fish_color_autosuggestion 3D8479
fish_color_cancel e78284
fish_color_command 8caaee
fish_color_comment 5C6773
fish_color_custom_one 1587DF
fish_color_custom_two 0E558C
fish_color_cwd 73D0FF
fish_color_end F29E74
fish_color_error FF3333
fish_color_escape 95E6CB
fish_color_gray 6e738d
fish_color_gray_bg 52576f
fish_color_gray_bg_dark 393552
fish_color_host normal
fish_color_host_remote yellow
fish_color_keyword 5CCFE6
fish_color_match F28779
fish_color_normal normal
fish_color_operator FFCC66
fish_color_option a6d189
fish_color_param eebebe
fish_color_quote BAE67E
fish_color_redirection f4b8e4
fish_color_search_match --background=FFCC66
fish_color_selection --background=FFCC66
fish_color_status e78284
fish_color_user 81c8be
fish_color_valid_path --underline
fish_pager_color_completion 1587DF
fish_pager_color_description B3A06D
fish_pager_color_prefix 4CBF99
fish_pager_color_progress brwhite '--background=cyan'
fish_pager_color_selected_background --background=FFCC66

fish_pager_color_background 181825
