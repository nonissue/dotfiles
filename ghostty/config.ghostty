window-padding-x = 18
window-padding-y = 12,6

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
# macos-window-buttons = hidden

background-opacity = 0.8
background-blur = macos-glass-regular

# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# cool themes (dark): twilight, traffic, Rouge 2, Poimandres, novmbr, Kanso Pearl, Kanso Mist, Kanso Ink, Kanagawabones, Everforest Dark Hard, branch
# cool themes (light): Rose Pine Dawn, Night Owlish Light, Light Owl, Kanso Zen, Flexoki Light, Farmhouse Light, Everforest Light Med,  Dayfox, Dawnfox, Belafonte Day
theme = light:Dawnfox,dark:novmbr

# font
font-family = "JetBrainsMono Nerd Font Mono"

shell-integration-features = no-cursor
cursor-style = underline
adjust-cursor-thickness = 3
mouse-hide-while-typing = true

window-inherit-working-directory = false
tab-inherit-working-directory = false
working-directory = home



# font-family = "Georgia"
# font-variation = wght=300
# font-variation = wdth=100
# font-family-bold = "Berkeley Mono Variable"
# font-variation-bold = wght=800
# Config generated by Ghostty Config

macos-icon = custom
macos-custom-icon = ~/.dotfiles/ghostty/ghostty-original.icns
# macos-titlebar-style = hidden  
# macos-titlebar-style = transparent  

# macos-icon = xray
# macos-icon-frame = beige
# macos-icon-ghost-color = #71715f
# macos-icon-screen-color = #ece8df

# Behavior
auto-update = check
window-save-state = always
notify-on-command-finish = unfocused

# Quick terminal (system-wide dropdown)
# keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

macos-option-as-alt = true

# Prompt jumping (uses shell integration, auto-enabled for fish)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Override the native 'edit config' shortcut with the CLI action, respecting ${VISUAL:-${EDITOR}}
#   1. `\x1bq` runs the zsh `push-line-or-edit` widget (bound to alt-q)
#   2. `ghostty +edit-config` is sent to the shell prompt
#   3. `\x0d` enters/executes the command currently on the prompt
keybind = unconsumed:super+,=text:\x1bqghostty +edit-config\x0d