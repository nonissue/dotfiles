window-padding-x = 12
window-padding-y = 6

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

background-opacity = 0.90
background-blur = macos-glass-regular     
# background-blur-radius = 40

# theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# cool themes (dark): twilight, traffic, Rouge 2, Poimandres, novmbr, Kanso Pearl, Kanso Mist, Kanso Ink, Kanagawabones, Everforest Dark Hard, branch
# cool themes (light): Rose Pine Dawn, Night Owlish Light, Neobones Light, Light Owl, Kanso Zen, Flexoki Light, Farmhouse Light, Everforest Light Med,  Dayfox, Dawnfox, Belafonte Day
theme = light:Kanso Pearl,dark:Kanso Ink

shell-integration-features = no-cursor
cursor-style = underline
adjust-cursor-thickness = 2
mouse-hide-while-typing = true

window-inherit-working-directory = false
tab-inherit-working-directory = false
working-directory = home

font-family = "JetBrainsMono Nerd Font Mono"
# font-family = "Georgia"
# font-variation = wght=300
# font-variation = wdth=100
# font-family-bold = "Berkeley Mono Variable"
# font-variation-bold = wght=800
# Config generated by Ghostty Config

macos-icon = custom
macos-custom-icon = ~/.dotfiles/ghostty/ghostty-original.icns

# macos-icon = xray
# macos-icon-frame = beige
# macos-icon-ghost-color = #71715f
# macos-icon-screen-color = #ece8df

# Behavior
auto-update = check
window-save-state = always

# Quick terminal (system-wide dropdown)
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# Prompt jumping (uses shell integration, auto-enabled for fish)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
