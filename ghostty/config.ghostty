window-padding-x = 12
window-padding-y = 6

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true

background-opacity = 0.80
background-blur = macos-glass-regular

theme = "Catppuccin Mocha"
# background-blur-radius = 40

mouse-hide-while-typing = true

window-inherit-working-directory = false
tab-inherit-working-directory = false
working-directory = home

font-family = "JetBrainsMono Nerd Font Mono"
# font-family = "Georgia"
# font-variation = wght=300
# font-variation = wdth=100
# font-family-bold = "Berkeley Mono Variable"
# font-variation-bold = wght=800
# Config generated by Ghostty Config

macos-icon = xray
macos-icon-frame = beige
macos-icon-ghost-color = #71715f
macos-icon-screen-color = #ece8df